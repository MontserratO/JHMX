# Justicia Hidrica - Configuracion del sitio (Apache)
#
# NOTA: este archivo esta escrito SOLO en ASCII (sin acentos ni simbolos
# especiales) a proposito. Apache en Windows lee el .htaccess byte a byte
# y los caracteres multibyte pueden hacer que falle al interpretarlo.
# Si lo editas, no agregues acentos ni guardes con BOM.


# 1. No listar el contenido de las carpetas.
Options -Indexes


# 2. URLs limpias, sin .php
#    /equipo      sirve equipo.php
#    /equipo.php  redirige a /equipo (evita contenido duplicado)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirige a la version sin .php cuando el .php viene en la peticion.
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Sirve el .php cuando la URL no lo lleva.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>


# 3. Pagina de error propia.
#    LOCAL (XAMPP):  /JHMX/error.php
#    SERVIDOR:       /justiciahidricamx/error.php
#    Cambia la ruta segun donde lo estes usando.
ErrorDocument 404 /JHMX/error.php
ErrorDocument 403 /JHMX/error.php
ErrorDocument 500 /JHMX/error.php


# 4. Cabeceras de seguridad.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>


# 5. Compresion de texto.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# 6. Cache del navegador para archivos que casi no cambian.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType image/png               "access plus 6 months"
    ExpiresByType image/gif               "access plus 6 months"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType application/pdf         "access plus 1 month"
    ExpiresByType video/mp4               "access plus 6 months"
    ExpiresByType text/css                "access plus 1 week"
    ExpiresByType application/javascript  "access plus 1 week"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>


# 7. Bloquear archivos sensibles que se pudieran subir por error.
<FilesMatch "\.(sql|log|ini|bak|old|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
